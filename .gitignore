node_modules/
dist/
build/

.env
.env.*
!.env.example

# Runtime volumes — un-ignore only placeholder keep files
data/*
!data/.gitkeep
!data/sessions/
data/sessions/*
!data/sessions/.gitkeep

# Telegram / local secrets
*.session
*.session-journal
*.json-journal
*.db
*.sqlite3

# Vite output embedded by the Go binary. Docker and `npm run build` regenerate it.
internal/webui/admin/*
!internal/webui/admin/.gitkeep
internal/webui/public/*
!internal/webui/public/.gitkeep

# Editor / OS junk
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
