DATABASE_URL=postgres://nexa:replace-with-a-long-db-password@127.0.0.1:5432/nexa?sslmode=disable
POSTGRES_PASSWORD=replace-with-a-long-db-password
# Must be ≥24 chars and not an example placeholder (startup rejects replace-with-*).
NEXA_ADMIN_TOKEN=replace-with-a-long-random-token
NEXA_PUBLIC_ADDR=:8080
NEXA_ADMIN_ADDR=127.0.0.1:8081
NEXA_SESSION_DIR=data/sessions
# Example image host; replace with your own. Keep NEXA_IMAGE_AUTH out of git.
NEXA_IMAGE_BASE_URL=https://image.kiteyuan.info
NEXA_IMAGE_AUTH=
NEXA_TG_PROXY=
NEXA_DEV=
